#usda 1.0
(
    subLayers = [@camera_responsivity.usda@, @../../../tests/docs/data/ovrtx-light-test-rect.usda@]
    metersPerUnit = 0.01
    upAxis = "Y"
)

over "World" {
    # Rest a pavilion facet on the floor; point the crown toward the camera and 65 degrees left.
    def Xform "Diamond" (
        prepend references = @../../../tests/docs/data/diamond.usd@
    ) {
        double3 xformOp:translate = (56, 0.566300980036, 3)
        quatd xformOp:orient = (0.72752349920949977, 0.33584322313840886, -0.57384802239100596, 0.1691665888049452)
        float3 xformOp:scale = (3, 3, 3)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
    }

    # Frame the existing chart and spheres closely; hold camera and exposure fixed across modes.
    over "Camera" {
        double3 xformOp:translate = (56, 25, 230)
        float3 xformOp:rotateYXZ = (0, 0, 0)
        float exposure:iso = 400
    }

    # [snippet:doc-spectral-illuminant]
    over "RectLight" (
        prepend apiSchemas = ["PhysicalLightIlluminantAPI", "PhotometricAreaLightAPI"]
        prepend variantSets = "illuminant"
        variants = { string illuminant = "white" }
    ) {
        # Hold luminous power fixed so spectral shape is the comparison variable.
        float photometric:power = 6400
        float inputs:intensity = 1
        float inputs:exposure = 0
        color3f inputs:color = (1, 1, 1)
        bool inputs:enableColorTemperature = false
        variantSet "illuminant" = {
            "white" {
                token physical:illuminant = "white"
            }
            "blackbody3200" {
                token physical:illuminant = "blackbody"
                float inputs:colorTemperature = 3200
            }
            "daylight" {
                token physical:illuminant = "illuminant D"
                float inputs:colorTemperature = 6504
            }
            "sodium" {
                token physical:illuminant = "custom"
                # Based on Colour Science LPS data (BSD-3-Clause); see COLOUR-LICENSE and SPECTRA.md.
                # Linear 1 nm resampling plus a synthetic 2 nm FWHM sodium doublet, peak-normalized.
                float2[] physical:customIlluminant = [
