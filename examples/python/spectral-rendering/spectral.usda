def "Render" {
    # [snippet:doc-spectral-render-product]
    def RenderProduct "Camera" (
        prepend apiSchemas = ["OmniRtxSettingsCommonAPI_1", "OmniRtxSettingsPtAPI_1"]
        prepend variantSets = "transport"
        variants = { string transport = "rgb" }
    ) {
        rel camera = </World/Camera>
        rel orderedVars = [<LdrColor>, <HdrColor>]
        int2 resolution = (512, 512)
        token omni:rtx:rendermode = "PathTracing"
        uint omni:rtx:pt:samplesPerPixel = 4096
        # Use the same denoising and firefly thresholds for every comparison.
        bool omni:rtx:pt:adaptiveSampling:enabled = false
        bool omni:rtx:pt:denoising:enabled = true
        bool omni:rtx:pt:fireflyFilter:enabled = true
        float omni:rtx:pt:fireflyFilter:maxUnexposedIntensityPerSample = 10000
        float omni:rtx:pt:fireflyFilter:maxUnexposedIntensityPerSampleDiffuse = 10000
        float omni:rtx:pt:fireflyFilter:maxPerEmissiveUnexposedIntensity = 10000
        bool omni:rtx:pt:radianceCache:enabled = false
        uint omni:rtx:pt:limits:maxBounces = 32
        # Spectral controls are custom attributes; no applied settings schema defines them.
        custom float omni:rtx:pathtracing:spectral:wavelengthMin = 360
        custom float omni:rtx:pathtracing:spectral:wavelengthMax = 830
        custom uint omni:rtx:pathtracing:spectral:responseCurve = 0
        variantSet "transport" = {
            "rgb" {
                custom bool omni:rtx:pathtracing:spectral:enabled = false
            }
            "spectral" {
                custom bool omni:rtx:pathtracing:spectral:enabled = true
            }
        }
        def RenderVar "LdrColor" {
            string sourceName = "LdrColor"
        }
        def RenderVar "HdrColor" {
            string sourceName = "HdrColor"
        }
    }
    # [/snippet:doc-spectral-render-product]
}
