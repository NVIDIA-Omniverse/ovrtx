#
# Slang variant of overlay_scene.usda. The rendered world is referenced from that scene;
# the render graph below differs only in the shader definition it
# instantiates.
(
    defaultPrim = "World"
    upAxis = "Y"
    metersPerUnit = 1
)

def Xform "World" (
    references = @overlay_scene.usda@</World>
)
{
}

def Scope "Render"
{
    def RenderProduct "OverlayDemo"
    {
        uniform int2 resolution = (512, 512)
        rel camera = </World/Rig/Camera>
        rel orderedVars = [ <LdrColor>, <Overlay> ]

        def RenderVar "LdrColor"
        {
            uniform string sourceName = "LdrColor"
            opaque omni:rtx:aov
        }

        def RenderVar "Overlay"
        {
            uniform string sourceName = "Overlay"
            opaque omni:rtx:aov.connect = <../MarkerOverlay.outputs:Overlay>
        }

        # The only difference from overlay_scene.usda: this references the Slang shader
        # definition instead of the CUDA one. The wiring is identical because both declare
        # the same ports.
        def Shader "MarkerOverlay" (
            references = @MarkerOverlayKernel.slang.usda@
        )
        {
            opaque inputs:Image.connect = <../LdrColor.omni:rtx:aov>
        }
    }
}
