(
    defaultPrim = "MarkerOverlayKernel"
)

# [snippet:marker-overlay-shader-definition]
# The marker overlay node. One image in, one image out, and a token naming the prim whose
# relationship lists the markers to draw. SPG finds the launch script by appending ".lua" to
# the source asset path (MarkerOverlayKernel.cu -> MarkerOverlayKernel.cu.lua).
def Shader "MarkerOverlayKernel"
{
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:spg:sourceAsset = @MarkerOverlayKernel.cu@
    uniform token info:spg:sourceAsset:subIdentifier = "markerOverlay"

    opaque inputs:Image
    token inputs:settings = "/World/Overlay"
    opaque outputs:Overlay
}
# [/snippet:marker-overlay-shader-definition]
