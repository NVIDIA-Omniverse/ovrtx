(
    defaultPrim = "MarkerOverlayKernel"
)

# The Slang implementation of the marker overlay node. Identical to MarkerOverlayKernel.usda
# except for the source asset: the file extension selects the backend. The ports are the same,
# so a scene swaps one for the other and changes nothing else.
def Shader "MarkerOverlayKernel"
{
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:spg:sourceAsset = @MarkerOverlayKernel.slang@
    uniform token info:spg:sourceAsset:subIdentifier = "markerOverlay"

    opaque inputs:Image
    token inputs:settings = "/World/Overlay"
    opaque outputs:Overlay
}
