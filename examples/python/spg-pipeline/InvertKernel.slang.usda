(
    defaultPrim = "InvertKernel"
)

# [snippet:invert-slang-shader-definition]
# Slang implementation of the invert node. The port declarations are identical
# to InvertKernel.usda, including the typed value-input: how a value reaches
# the GPU differs per backend, but how it is declared in USD does not.
def Shader "InvertKernel"
{
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:spg:sourceAsset = @InvertKernel.slang@
    uniform token info:spg:sourceAsset:subIdentifier = "invert"

    float inputs:strength = 1.0

    opaque inputs:Image
    opaque outputs:Inverted
}
# [/snippet:invert-slang-shader-definition]
