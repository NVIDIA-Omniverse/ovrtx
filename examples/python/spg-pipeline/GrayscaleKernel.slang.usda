(
    defaultPrim = "GrayscaleKernel"
)

# Reusable SPG shader definition for the Slang implementation. Identical to
# GrayscaleKernel.usda except for the source asset: the file extension selects
# the backend (.cu -> CUDA, .slang -> Slang). The ports are the same, so a
# scene can swap one for the other without any other change.
#
# SPG finds the launch script by appending ".lua" to the source asset path
# (GrayscaleKernel.slang -> GrayscaleKernel.slang.lua), so keep them co-located.
def Shader "GrayscaleKernel"
{
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:spg:sourceAsset = @GrayscaleKernel.slang@
    uniform token info:spg:sourceAsset:subIdentifier = "grayscale"

    # opaque resource ports: the concrete dtype/shape is resolved at runtime
    # by the launch script.
    opaque inputs:LdrColor
    opaque outputs:LdrGrayscale
}
