#
# Slang variant of grayscale_scene.usda. The rendered world is referenced from
# that scene so this file shows only what differs between the two backends:
# the shader definition it instantiates.
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World" (
    references = @grayscale_scene.usda@</World>
)
{
}

# [snippet:render-graph]
def Scope "Render"
{
    def RenderProduct "GrayscaleDemo"
    {
        uniform int2 resolution = (1280, 720)
        rel camera = </World/Camera>
        rel orderedVars = [ <LdrColor>, <LdrGrayscale> ]

        def RenderVar "LdrColor"
        {
            uniform string sourceName = "LdrColor"
            opaque omni:rtx:aov
        }

        def RenderVar "LdrGrayscale"
        {
            uniform string sourceName = "LdrGrayscale"
            opaque omni:rtx:aov.connect = <../GrayscaleKernel.outputs:LdrGrayscale>
        }

        # The only difference from grayscale_scene.usda: this references the
        # Slang shader definition instead of the CUDA one. The wiring is
        # identical because both declare the same ports.
        def Shader "GrayscaleKernel" (
            references = @GrayscaleKernel.slang.usda@
        )
        {
            opaque inputs:LdrColor.connect = <../LdrColor.omni:rtx:aov>
        }
    }
}
# [/snippet:render-graph]
