(
    defaultPrim = "BlurHorizontal"
)

def Shader "BlurHorizontal"
{
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:spg:sourceAsset = @BlurKernel.slang@
    uniform token info:spg:sourceAsset:subIdentifier = "blurHorizontal"

    # Both passes declare the same ports and differ only in the entry point they
    # name, so one source asset and one launch script serve both.
    opaque inputs:Image
    int inputs:radius = 8
    opaque outputs:Blurred
}
