#
# Slang variant of trail_scene.usda. The rendered world is referenced from that
# scene so this file shows only what differs between the two backends: the
# shader definition it instantiates.
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World" (
    references = @trail_scene.usda@</World>
)
{
}

# [snippet:render-graph]
def Scope "Render"
{
    def RenderProduct "TrailDemo"
    {
        uniform int2 resolution = (1280, 720)
        rel camera = </World/Camera>
        rel orderedVars = [ <HdrColor>, <LdrLive>, <LdrTrail> ]

        def RenderVar "HdrColor"
        {
            uniform string sourceName = "HdrColor"
            opaque omni:rtx:aov
        }

        def RenderVar "LdrLive"
        {
            uniform string sourceName = "LdrLive"
            opaque omni:rtx:aov.connect = <../TrailKernel.outputs:Live>
        }

        def RenderVar "LdrTrail"
        {
            uniform string sourceName = "LdrTrail"
            opaque omni:rtx:aov.connect = <../TrailKernel.outputs:Trail>
        }

        # The only difference from trail_scene.usda: this references the Slang
        # shader definition instead of the CUDA one. The wiring is identical
        # because both declare the same ports.
        def Shader "TrailKernel" (
            references = @TrailKernel.slang.usda@
        )
        {
            opaque inputs:Image.connect = <../HdrColor.omni:rtx:aov>
        }
    }
}
# [/snippet:render-graph]
