(
    defaultPrim = "TrailKernel"
)

# [snippet:trail-shader-definition]
# One input and two outputs. Live and Trail are both published and are
# tone-mapped identically.
# The feedback framebuffer, History, is memory of the node, stated
# in the launch script.
def Shader "TrailKernel"
{
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:spg:sourceAsset = @TrailKernel.cu@
    uniform token info:spg:sourceAsset:subIdentifier = "trail"

    # Fraction of the previous frame kept, which sets the whole length of the
    # tail: a pixel the ball crossed k frames ago still holds decay^k of the
    # light it left. Values closer to 1 give longer tails, and 0.0 keeps nothing
    # and makes Trail identical to Live.
    float inputs:decay = 0.7

    opaque inputs:Image
    opaque outputs:Live
    opaque outputs:Trail
}
# [/snippet:trail-shader-definition]
