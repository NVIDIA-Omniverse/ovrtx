(
    defaultPrim = "TrailKernel"
)

# [snippet:trail-slang-shader-definition]
# Identical to TrailKernel.usda except for the source asset. The ports are the
# same, so the scene wiring does not change between the two backends.
def Shader "TrailKernel"
{
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:spg:sourceAsset = @TrailKernel.slang@
    uniform token info:spg:sourceAsset:subIdentifier = "trail"

    float inputs:decay = 0.7

    opaque inputs:Image
    opaque outputs:History
    opaque outputs:Live
    opaque outputs:Trail
}
# [/snippet:trail-slang-shader-definition]
