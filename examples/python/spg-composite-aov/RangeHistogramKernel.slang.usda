(
    defaultPrim = "RangeHistogramKernel"
)

# [snippet:histogram-slang-shader-definition]
# Identical to RangeHistogramKernel.usda except for the source asset. The ports
# are the same, so the scene wiring does not change between the two backends.
def Shader "RangeHistogramKernel"
{
    uniform token info:implementationSource = "sourceAsset"
    uniform asset info:spg:sourceAsset = @RangeHistogramKernel.slang@
    uniform token info:spg:sourceAsset:subIdentifier = "rangeHistogram"

    # The two chart axes, in scene units (metres here) and in returns per bin.
    # main.py prints the sweep's furthest return and busiest bin so both can be
    # retuned for another sensor or scene.
    float inputs:maxRange = 12.8
    float inputs:maxCount = 15000.0

    # Distance bins across the chart. The output is 512 wide, so this must
    # divide 512 evenly. 32 bins over 12.8 m are 0.4 m wide, which puts each
    # box's front face inside a bin rather than on a boundary, where the
    # sensor's range noise would split one bar into two.
    int inputs:numBins = 32

    opaque inputs:PointCloud
    opaque outputs:Histogram
}
# [/snippet:histogram-slang-shader-definition]
