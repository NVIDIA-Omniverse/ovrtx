    def Scope "Looks"
    {
        def Material "mtl_uvalign"
        {
            token outputs:mdl:displacement.connect = </World/Looks/mtl_uvalign/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/mtl_uvalign/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/mtl_uvalign/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                asset inputs:diffuse_texture = @../../../tests/docs/data/uv-align.png@ (
                    colorSpace = "auto"
                )
                token outputs:out (
                    renderType = "material"
                )
            }
        }
    }

