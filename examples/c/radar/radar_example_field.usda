        }
    }

    # The example's moving target: 1.5 m steel cube closing in along world -X at
    # 10 m/s, one meter per 0.1 s time code.
    def Cube "MovingSteelCube" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        double size = 1.5
        color3f[] primvars:displayColor = [(0.55, 0.55, 0.60)]
        rel material:binding = </World/Materials/Steel>
        double3 xformOp:translate.timeSamples = {
            0: (30, 4, 0.75),
            1: (29, 4, 0.75),
            2: (28, 4, 0.75),
            3: (27, 4, 0.75),
            4: (26, 4, 0.75),
            5: (25, 4, 0.75),
            6: (24, 4, 0.75),
            7: (23, 4, 0.75),
            8: (22, 4, 0.75),
            9: (21, 4, 0.75),
            10: (20, 4, 0.75)
        }
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    # [/snippet:configure-radar-field-targets]

    def DistantLight "DistantLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float intensity = 2500
        float3 xformOp:rotateXYZ = (315, 45, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    # Sky light for the camera product only; sensors do not use lights.
    def DomeLight "Sky"
    {
        float inputs:intensity = 120
        color3f inputs:color = (0.78, 0.84, 0.95)
    }

    # The camera the CameraProduct below renders through. The radar example steps
    # only its sensor product; step the CameraProduct to see the scene.
    def Camera "PreviewCamera"
    {
        float focalLength = 15.00
        float horizontalAperture = 20.955
        float verticalAperture = 11.787
        float2 clippingRange = (0.1, 500)
        matrix4d xformOp:transform = ( (0.469155, -0.883116, 0.000000, 0.000000), (0.563181, 0.299190, 0.770268, 0.000000), (-0.680235, -0.361375, 0.637721, 0.000000), (-30.000000, -34.000000, 60.000000, 1.000000) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    # [snippet:configure-radar-field-output]
    def "Render"
    {
        def "Products"
        {
            def RenderProduct "RadarProduct"
            {
                rel camera = </World/Radar>
                rel orderedVars = [<../../Vars/PointCloud>]
            }

            def RenderProduct "CameraProduct"
            {
                rel camera = </World/PreviewCamera>
                int2 resolution = (960, 540)
                token omni:rtx:rendermode = "RealTimePathTracing"
                rel orderedVars = [<../../Vars/LdrColor>]
            }
        }

        def "Vars"
        {
            def RenderVar "PointCloud"
            {
                uniform string sourceName = "PointCloud"
                token[] channels = [
                    "Coordinates",
                    "Counts",
                    "RCS",
                    "RadialVelocityMs"
                ]
            }

            def RenderVar "LdrColor"
            {
                uniform string sourceName = "LdrColor"
            }
        }
    }
    # [/snippet:configure-radar-field-output]

    # [snippet:configure-radar-field-materials]
    # One Material prim serves two systems: the omni:simready:nonvisual labels are
    # what the radar reads, the MDL shader is what the camera renders.
    def Xform "Materials"
    {
        def Material "Asphalt"
        {
            token omni:simready:nonvisual:base = "asphalt"
            token omni:simready:nonvisual:coating = "none"
            token[] omni:simready:nonvisual:attributes = ["none"]
            token outputs:mdl:surface.connect = </World/Materials/Asphalt/Shader.outputs:out>
            token outputs:mdl:displacement.connect = </World/Materials/Asphalt/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Materials/Asphalt/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.07, 0.07, 0.08)
                float inputs:reflection_roughness_constant = 0.95
                float inputs:metallic_constant = 0
                token outputs:out
            }
        }
        def Material "Steel"
        {
            token omni:simready:nonvisual:base = "steel"
            token omni:simready:nonvisual:coating = "none"
            token[] omni:simready:nonvisual:attributes = ["none"]
            token outputs:mdl:surface.connect = </World/Materials/Steel/Shader.outputs:out>
            token outputs:mdl:displacement.connect = </World/Materials/Steel/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Materials/Steel/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.72, 0.72, 0.74)
                float inputs:reflection_roughness_constant = 0.32
                float inputs:metallic_constant = 1
                token outputs:out
            }
        }
    }
    # [/snippet:configure-radar-field-materials]
}
