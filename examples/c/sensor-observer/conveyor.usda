(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Ground"
    {
        # Three square tiles preserve the grid's aspect ratio over a 12 m by 4 m strip.
        double3 xformOp:scale = (4, 4, 4)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        def Xform "Left" (prepend references = @../../../tests/docs/data/ground.usd@)
        {
            double3 xformOp:translate = (-100, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Xform "Center" (prepend references = @../../../tests/docs/data/ground.usd@)
        {
        }
        def Xform "Right" (prepend references = @../../../tests/docs/data/ground.usd@)
        {
            double3 xformOp:translate = (100, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
    def Xform "Cube" (prepend references = @../../../tests/docs/data/cube.usd@)
    {
        double3 xformOp:translate = (-300, 60, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Cube"
        {
            color3f[] primvars:displayColor = [(0.9, 0.12, 0.025)]
        }
    }
    def Xform "Sphere" (prepend references = @../../../tests/docs/data/sphere.usd@)
    {
        double3 xformOp:translate = (0, 60, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Sphere"
        {
            color3f[] primvars:displayColor = [(0.025, 0.3, 0.85)]
        }
    }
    def Xform "Cone" (prepend references = @../../../tests/docs/data/cone.usd@)
    {
        double3 xformOp:translate = (300, 60, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        over "Cone"
        {
            color3f[] primvars:displayColor = [(0.08, 0.6, 0.16)]
        }
    }
    def DomeLight "DomeLight"
    {
        float inputs:intensity = 1000
        asset inputs:texture:file = @../../../tests/docs/data/studio.exr@
        token inputs:texture:format = "latlong"
        float3 xformOp:rotateXYZ = (0, 270, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    # [snippet:doc-observer-cameras-usda]
    def Camera "Sensor" (prepend apiSchemas = ["OmniSensorAPI"])
    {
        # Instant global-shutter captures at 30 Hz of simulation time.
        double2 omni:sensor:frameRate = (30, 1)
        # Cameras do not provide partial outputs
        bool omni:sensor:Core:partialOutputs = false
        float focalLength = 24
        double3 xformOp:translate = (0, 1000, 0)
        float3 xformOp:rotateXYZ = (-90, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Camera "Observer"
    {
        # No sensor frame rate or exposure: render even when delta_time is zero.
        float focalLength = 24
        double3 xformOp:translate = (900, 700, 1000)
        float3 xformOp:rotateXYZ = (-28, 42, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
    # [/snippet:doc-observer-cameras-usda]
}

def Scope "Render"
{
    def RenderProduct "Sensor"
    {
        int2 resolution = (480, 360)
        uint[] deviceIds = [0]
        rel camera = </World/Sensor>
        rel orderedVars = <LdrColor>
        token omni:rtx:rendermode = "RealTimePathTracing"
        def RenderVar "LdrColor"
        {
            string sourceName = "LdrColor"
        }
    }
    def RenderProduct "Observer"
    {
        int2 resolution = (1280, 720)
        uint[] deviceIds = [0]
        rel camera = </World/Observer>
        rel orderedVars = <LdrColor>
        token omni:rtx:rendermode = "RealTimePathTracing"
        def RenderVar "LdrColor"
        {
            string sourceName = "LdrColor"
        }
    }
}
