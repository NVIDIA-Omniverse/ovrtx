If:
  PathMatch: ".*\\.(cu|cuh)$"

CompileFlags:
  Add:
    [
      "-xcuda",
      "--cuda-gpu-arch=sm_86",                # choose your arch
      "--cuda-path=/home/<username>/packages/cuda/12.3.2",     # adjust for your system
      "-I/home/<username>/packages/cuda/12.3.2/include",      # CUDA headers
    ]