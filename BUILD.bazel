# Header-only wrapper for ovrtx public headers (e.g. ovx/dlpack/dlpack.h).
# Used by sensors that consume rtx/common/RenderOutput.h transitively.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "ovrtx_public_headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
)
