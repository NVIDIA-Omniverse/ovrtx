    uint[] omni:sensor:Core:emitterState:s001:fireTimeNs = [
        0, 0, 0, 0, 0, 0, 0, 0,
        2665, 2665, 2665, 2665, 2665, 2665, 2665, 2665,
        5330, 5330, 5330, 5330, 5330, 5330, 5330, 5330,
