        double3 xformOp:translate = (5.04, -3.5, 1.0)
        float3 xformOp:scale = (0.06, 0.06, 2.0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def DistantLight "DistantLight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float intensity = 4000
        float3 xformOp:rotateXYZ = (315, 45, 0)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def DomeLight "Sky"
    {
        float inputs:intensity = 1000
        color3f inputs:color = (0.78, 0.84, 0.95)
    }

    def Camera "PreviewCamera"
    {
        float focalLength = 14.42
        float horizontalAperture = 20.955
        float verticalAperture = 11.787
        float2 clippingRange = (0.1, 500)
        matrix4d xformOp:transform = ( (0.447214, -0.894427, 0.000000, 0.000000), (0.180804, 0.090402, 0.979356, 0.000000), (-0.875962, -0.437981, 0.202145, 0.000000), (-5.500000, -6.500000, 4.200000, 1.000000) )
        uniform token[] xformOpOrder = ["xformOp:transform"]
    }

    def "Render"
    {
        def "Products"
        {
            def RenderProduct "LidarProduct"
            {
                rel camera = </World/Lidar>
                rel orderedVars = [<../../Vars/PointCloud>]
            }

            def RenderProduct "CameraProduct"
            {
                rel camera = </World/PreviewCamera>
                int2 resolution = (960, 540)
                token omni:rtx:rendermode = "RealTimePathTracing"
                rel orderedVars = [<../../Vars/LdrColor>]
            }
        }

        def "Vars"
        {
            def RenderVar "PointCloud"
            {
                uniform string sourceName = "PointCloud"
                token[] channels = []
            }

            def RenderVar "LdrColor"
            {
                uniform string sourceName = "LdrColor"
            }
        }
    }

    def Xform "Materials"
    {
        def Material "Asphalt"
        {
            token omni:simready:nonvisual:base = "asphalt"
            token omni:simready:nonvisual:coating = "none"
            token[] omni:simready:nonvisual:attributes = ["none"]
            token outputs:mdl:surface.connect = </World/Materials/Asphalt/Shader.outputs:out>
            token outputs:mdl:displacement.connect = </World/Materials/Asphalt/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Materials/Asphalt/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.07, 0.07, 0.08)
                float inputs:reflection_roughness_constant = 0.95
                float inputs:metallic_constant = 0
                token outputs:out
            }
        }
        def Material "Concrete"
        {
            token omni:simready:nonvisual:base = "concrete"
            token omni:simready:nonvisual:coating = "none"
            token[] omni:simready:nonvisual:attributes = ["none"]
            token outputs:mdl:surface.connect = </World/Materials/Concrete/Shader.outputs:out>
            token outputs:mdl:displacement.connect = </World/Materials/Concrete/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Materials/Concrete/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.58, 0.56, 0.52)
                float inputs:reflection_roughness_constant = 0.9
                float inputs:metallic_constant = 0
                token outputs:out
            }
        }
        def Material "Glass"
        {
            token omni:simready:nonvisual:base = "clear_glass"
            token omni:simready:nonvisual:coating = "none"
            token[] omni:simready:nonvisual:attributes = ["none"]
            token outputs:mdl:surface.connect = </World/Materials/Glass/Shader.outputs:out>
            token outputs:mdl:displacement.connect = </World/Materials/Glass/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Materials/Glass/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
                color3f inputs:glass_color = (0.82, 0.93, 0.96)
                float inputs:glass_ior = 1.5
                bool inputs:thin_walled = true
                token outputs:out
            }
        }
        def Material "Aluminum"
