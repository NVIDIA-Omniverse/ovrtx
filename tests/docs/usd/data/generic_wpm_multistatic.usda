# [snippet:doc-generic-wpm-multistatic]
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    timeCodesPerSecond = 10
    subLayers = [@generic_wpm_base.usda@]
)

over "World"
{
    over "Sensor"
    {
        # About 77 GHz in vacuum; material response depends on wavelength.
        float omni:sensor:GenericWpm:wavelengthNm = 3900000
        token[] omni:sensor:GenericWpm:tx:patternTypes = ["free"]
        uint[] omni:sensor:GenericWpm:freePatterns:tx:numElementsPerPattern = [2]
        float3[] omni:sensor:GenericWpm:freePatterns:tx:positions = [(0, -0.5, 0), (0, 0.5, 0)]
        float4[] omni:sensor:GenericWpm:freePatterns:tx:orientations = [(0, 0, 0, 1), (0, 0, 0, 1)]
        token[] omni:sensor:GenericWpm:rx:patternTypes = ["free"]
        uint[] omni:sensor:GenericWpm:freePatterns:rx:numElementsPerPattern = [3]
        float3[] omni:sensor:GenericWpm:freePatterns:rx:positions = [(0, -0.4, 0), (0, 0, 0), (0, 0.4, 0)]
        float4[] omni:sensor:GenericWpm:freePatterns:rx:orientations = [(0, 0, 0, 1), (0, 0, 0, 1), (0, 0, 0, 1)]

        # Each transmitter emits the same nine transmitter-relative rays.
        token[] omni:sensor:GenericWpm:ray:patternTypes = ["grid"]
        token[] omni:sensor:GenericWpm:gridPatterns:ray:modes = ["SPHERICAL"]
        uint[] omni:sensor:GenericWpm:gridPatterns:ray:numRows = [3]
        uint[] omni:sensor:GenericWpm:gridPatterns:ray:numCols = [3]
        float[] omni:sensor:GenericWpm:gridPatterns:ray:startRowUnits = [-5]
        float[] omni:sensor:GenericWpm:gridPatterns:ray:endRowUnits = [5]
        float[] omni:sensor:GenericWpm:gridPatterns:ray:startColUnits = [-5]
        float[] omni:sensor:GenericWpm:gridPatterns:ray:endColUnits = [5]
        token[] omni:sensor:GenericWpm:gridPatterns:ray:layouts = ["rowMajor"]
        float3[] omni:sensor:GenericWpm:gridPatterns:ray:positions = [(0, 0, 0)]
        float4[] omni:sensor:GenericWpm:gridPatterns:ray:orientations = [(0, 0, 0, 1)]
        uint[] omni:sensor:GenericWpm:tx:rayPatternIndices = [0]
        token[] omni:sensor:GenericWpm:tx:mappingModes = ["nton"]
    }
}
# [/snippet:doc-generic-wpm-multistatic]
