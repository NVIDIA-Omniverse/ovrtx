def Xform "World"
{
    # [snippet:doc-projector-light]
    def RectLight "Projector"
    {
        bool isProjector = true
        float inputs:width = 1.5
        float inputs:height = 1
        float inputs:intensity = 10000

        # This is the color image being projected.
        asset inputs:texture:file = @../../data/chelsea.png@

        # This optional direction lookup reshapes the projection.
        asset projector:directionTexture:file = @../../data/projector-fisheye-direction.exr@
    }
    # [/snippet:doc-projector-light]
}
