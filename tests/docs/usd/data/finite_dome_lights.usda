def Xform "World"
{
    # [snippet:doc-finite-dome-light]
    def DomeLight "Studio"
    {
        asset inputs:texture:file = @../../data/studio.exr@
        token inputs:texture:format = "latlong"

        # OmniFiniteDomeLightAPI is auto-applied to DomeLight prims.
        token omni:rtx:domeLight:mode = "sphereWithGround"
        float omni:rtx:domeLight:radius = 5
        float3 omni:rtx:domeLight:size = (10, 6, 8)
        float omni:rtx:domeLight:groundTextureScale = 10

        # Use a separate transform to position and scale the finite geometry.
        rel coordSys:domeGeometry:binding = </World/DomeGeometry>
    }

    def Xform "DomeGeometry"
    {
        double3 xformOp:translate = (0, 2, 0)
        double3 xformOp:scale = (1, 1, 1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
    # [/snippet:doc-finite-dome-light]
}
