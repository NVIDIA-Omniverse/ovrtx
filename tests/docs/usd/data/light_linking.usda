def Xform "World"
{
    # [snippet:doc-light-linking]
    def SphereLight "KeyLight"
    {
        float inputs:intensity = 1000

        # Illuminate only Subjects and Ground, including their descendants.
        uniform bool collection:lightLink:includeRoot = false
        uniform token collection:lightLink:expansionRule = "expandPrims"
        rel collection:lightLink:includes = [
            </World/Subjects>,
            </World/Ground>,
        ]

        # All geometry casts shadows except NoShadow.
        uniform bool collection:shadowLink:includeRoot = true
        rel collection:shadowLink:excludes = </World/Subjects/NoShadow>
    }
    # [/snippet:doc-light-linking]

    def Xform "Subjects"
    {
        def Sphere "Linked"
        {
        }

        def Sphere "NoShadow"
        {
        }
    }

    def Cube "Ground"
    {
    }

    def Sphere "Unlinked"
    {
    }
}
