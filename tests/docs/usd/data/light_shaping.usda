def Xform "World"
{
    # [snippet:doc-light-shaping]
    def RectLight "ShapedPanel" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:shaping:cone:angle = 45
        float inputs:shaping:cone:softness = 0.25
        float inputs:shaping:focus = 2
        color3f inputs:shaping:focusTint = (0.1, 0.2, 1)
        token omni:rtx:shaping:forwardAxis = "-Z"
    }
    # [/snippet:doc-light-shaping]

    # [snippet:doc-light-shaping-ies]
    def DiskLight "IesDownlight" (
        prepend apiSchemas = ["ShapingAPI"]
    )
    {
        float inputs:shaping:ies:angleScale = 1
        asset inputs:shaping:ies:file = @../../data/ies/bega-50898.4K3.ies@
        bool inputs:shaping:ies:normalize = true
    }
    # [/snippet:doc-light-shaping-ies]
}
