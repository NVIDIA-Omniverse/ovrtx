# [snippet:doc-nonvisual-lidar-wpm-howto-tile-lidars-1]
#usda 1.0
(
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Sensor"
{
    def OmniLidar "Lidar" (
        prepend apiSchemas = ["OmniSensorGenericLidarWpmAPI"]
    )
    {
        token visibility = "invisible"
        double2 omni:sensor:frameRate = (10, 1)
        token omni:sensor:LidarWpm:scanType = "solidState"
        uint omni:sensor:LidarWpm:maxReturns = 1
        uint omni:sensor:LidarWpm:tiledSubSampling = 2

        float[] omni:sensor:LidarWpm:firingPattern:p001:azimuthDeg = [0, 0]
        float[] omni:sensor:LidarWpm:firingPattern:p001:elevationDeg = [0, 0]
        uint[] omni:sensor:LidarWpm:firingPattern:p001:fireTimeNs = [0, 1000]
        uint[] omni:sensor:LidarWpm:firingPattern:p001:channelId = [1, 4]
        uint[] omni:sensor:LidarWpm:firingPattern:p001:rangeId = []

        double3 xformOp:translate = (0, -4, 1)
        float3 xformOp:rotateXYZ = (90, 0, -90)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def OmniLidar "LidarTile1" (
        prepend apiSchemas = ["OmniSensorGenericLidarWpmAPI"]
    )
    {
        token visibility = "invisible"
        double3 xformOp:translate = (0, 4, 2)
        float3 xformOp:rotateXYZ = (90, 0, -90)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }

    def Scope "Outputs"
    {
        def RenderProduct "Product"
        {
            rel camera = [</Sensor/Lidar>, </Sensor/LidarTile1>]
            rel orderedVars = [</Sensor/Outputs/PointCloud>]
        }

        def RenderVar "PointCloud"
        {
            uniform string sourceName = "PointCloud"
            token[] channels = []
        }
    }
}
# [/snippet:doc-nonvisual-lidar-wpm-howto-tile-lidars-1]
