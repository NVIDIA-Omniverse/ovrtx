# [snippet:doc-nonvisual-lidar-core-tutorials-velodyne-alpha-prime-6]
#usda 1.0

(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Sensors"
    {
        over "AlphaPrime" (
            prepend references = @./Velodyne_Alpha_Prime_Rev4.usda@
        )
        {
            double3 xformOp:translate = (0, 0, 2)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
# [/snippet:doc-nonvisual-lidar-core-tutorials-velodyne-alpha-prime-6]
