#usda 1.0

# [snippet:doc-lidar-wpm-firing-pattern-solid-state]
(
    metersPerUnit = 1
    timeCodesPerSecond = 10
    upAxis = "Z"
)

def Xform "Sensor"
{
    def OmniLidar "Lidar" (
        prepend apiSchemas = [
            "OmniSensorGenericLidarWpmAPI",
            "OmniSensorGenericLidarWpmFiringPatternAPI:p002"
        ]
    )
    {
        token visibility = "invisible"
        double2 omni:sensor:frameRate = (10, 1)
        token omni:sensor:LidarWpm:scanType = "solidState"
        uint omni:sensor:LidarWpm:firingPatternDwellTicks = 2
        uint omni:sensor:LidarWpm:maxReturns = 2

        float[] omni:sensor:LidarWpm:firingPattern:p001:azimuthDeg = [-1, 1]
        float[] omni:sensor:LidarWpm:firingPattern:p001:elevationDeg = [0, 0]
        uint[] omni:sensor:LidarWpm:firingPattern:p001:fireTimeNs = [0, 1000]
        uint[] omni:sensor:LidarWpm:firingPattern:p001:channelId = [1, 2]
        uint[] omni:sensor:LidarWpm:firingPattern:p001:rangeId = []

        float[] omni:sensor:LidarWpm:firingPattern:p002:azimuthDeg = [0]
        float[] omni:sensor:LidarWpm:firingPattern:p002:elevationDeg = [0]
        uint[] omni:sensor:LidarWpm:firingPattern:p002:fireTimeNs = [0]
        uint[] omni:sensor:LidarWpm:firingPattern:p002:channelId = [2]
        uint[] omni:sensor:LidarWpm:firingPattern:p002:rangeId = []
    }

    def Scope "Outputs"
    {
        def RenderProduct "Product"
        {
            rel camera = </Sensor/Lidar>
            rel orderedVars = [</Sensor/Outputs/PointCloud>]
        }

        def RenderVar "PointCloud"
        {
            uniform string sourceName = "PointCloud"
            token[] channels = [
                "Coordinates", "Intensity", "TimeOffsetNs", "Flags",
                "ChannelId", "FiringPatternIndex"
            ]
        }
    }
}
# [/snippet:doc-lidar-wpm-firing-pattern-solid-state]
