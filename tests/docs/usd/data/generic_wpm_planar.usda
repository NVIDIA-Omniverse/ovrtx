# [snippet:doc-generic-wpm-planar]
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
    timeCodesPerSecond = 10
    subLayers = [@generic_wpm_depth.usda@]
)

over "World"
{
    over "Sensor"
    {
        # Rows are Z positions and columns are Y positions, in meters.
        # Every cell points along +X; this is not a perspective camera.
        token[] omni:sensor:GenericWpm:gridPatterns:tx:modes = ["PLANAR"]
        float[] omni:sensor:GenericWpm:gridPatterns:tx:startRowUnits = [-1]
        float[] omni:sensor:GenericWpm:gridPatterns:tx:endRowUnits = [1]
        float[] omni:sensor:GenericWpm:gridPatterns:tx:startColUnits = [-2]
        float[] omni:sensor:GenericWpm:gridPatterns:tx:endColUnits = [2]
        token[] omni:sensor:GenericWpm:gridPatterns:rx:modes = ["PLANAR"]
        float[] omni:sensor:GenericWpm:gridPatterns:rx:startRowUnits = [-1]
        float[] omni:sensor:GenericWpm:gridPatterns:rx:endRowUnits = [1]
        float[] omni:sensor:GenericWpm:gridPatterns:rx:startColUnits = [-2]
        float[] omni:sensor:GenericWpm:gridPatterns:rx:endColUnits = [2]
    }
}
# [/snippet:doc-generic-wpm-planar]
