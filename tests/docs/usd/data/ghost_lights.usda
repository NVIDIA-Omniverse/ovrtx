# [snippet:doc-ghost-lights]
def Xform "World"
{
    def RectLight "Softbox"
    {
        # Keep illuminating the scene, but hide the source from camera rays.
        bool visibleInPrimaryRay = false

        # Suppress the source in specular and glossy interactions.
        float ghostFactor = 0.5
    }

    def Sphere "Subject"
    {
        # Per-object ghosting overrides the light and RenderProduct values.
        float primvars:omni:rtx:ghostFactor = 1
    }
}

def "Render"
{
    def RenderProduct "Camera" (
        prepend apiSchemas = ["OmniRtxSettingsCommonAPI_1"]
    )
    {
        token omni:rtx:lights:visibilityOverride = "perLight"
        float omni:rtx:lights:reflectionVisibleRoughnessThreshold = 0.15
        float omni:rtx:lights:refractionVisibleRoughnessThreshold = 0.8
    }
}
# [/snippet:doc-ghost-lights]
