mdl 1.3;

import df::*;
import base::*;
import math::*;
import state::*;
import tex::*;
import anno::*;

export material SimpleDiffuse(
    color tint = color(1.f, 1.f, 1.f),
    float intensity = 1.f,
    float roughness = 0.f)
 = material(
    thin_walled: false,
    surface: material_surface(df::diffuse_reflection_bsdf(
        intensity * tint,
        roughness,
        ""), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    ior: color(1.f, 1.f, 1.f),
    volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
    geometry: material_geometry(
        float3(0.f),
        1.f,
        state::normal()));

export material TexturedDiffuse(
    uniform texture_2d texture,
    uniform float3 rotation = float3(0.f),
    uniform float3 translation = float3(0.f),
    uniform float3 scaling = float3(1.f),
    float intensity = 1.f)
 =
    let
        uniform float4x4 t = base::rotation_translation_scale(
            rotation,
            translation,
            scaling);
    in
        material(
            thin_walled: false,
            surface: material_surface(df::diffuse_reflection_bsdf(
                base::file_texture(
                    texture,
                    color(0.f, 0.f, 0.f),
                    color(intensity),
                    base::mono_alpha,
                    base::transform_coordinate(t, base::texture_coordinate_info(
                        state::texture_coordinate(0),
                        state::texture_tangent_u(0),
                        state::texture_tangent_v(0),
                        0)),
                    float2(0.f, 1.f),
                    float2(0.f, 1.f),
                    tex::wrap_repeat,
                    tex::wrap_repeat,
                    false,
                    0.f,
                    int2(0),
                    tex::wrap_repeat,
                    30.f).tint,
                0.f,
                ""), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            ior: color(1.f, 1.f, 1.f),
            volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
            geometry: material_geometry(
                float3(0.f),
                1.f,
                state::normal()));

export material LayeredSpecularDiffuse(
    color tint = color(1.f, 1.f, 1.f),
    float weight = 0.5f)
 = material(
    thin_walled: false,
    surface: material_surface(df::weighted_layer(
        weight,
        df::specular_bsdf(
            tint,
            df::scatter_reflect,
            ""),
        df::diffuse_reflection_bsdf(
            tint,
            0.f,
            ""),
        state::normal()), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    ior: color(1.f, 1.f, 1.f),
    volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
    geometry: material_geometry(
        float3(0.f),
        1.f,
        state::normal()));

export material SimpleLayer(
    material base,
    material layer,
    uniform texture_2d mask)
 =
    let
        float mask_result = base::file_texture(
            mask,
            color(0.f, 0.f, 0.f),
            color(1.f, 1.f, 1.f),
            base::mono_luminance,
            base::texture_coordinate_info(
                state::texture_coordinate(0),
                state::texture_tangent_u(0),
                state::texture_tangent_v(0),
                0),
            float2(0.f, 1.f),
            float2(0.f, 1.f),
            tex::wrap_repeat,
            tex::wrap_repeat,
            false,
            0.f,
            int2(0),
            tex::wrap_repeat,
            30.f).mono;
    in
        material(
            thin_walled: false,
            surface: material_surface(df::weighted_layer(
                mask_result,
                layer.surface.scattering,
                base.surface.scattering,
                state::normal()), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            ior: color(1.f, 1.f, 1.f),
            volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
            geometry: material_geometry(
                float3(0.f),
                1.f,
                state::normal()));

export material LayeredDiffuseGlossy(
    float normal_reflectivity = 0.200000003f,
    float grazing_reflectivity = 1.f,
    float exponent = 5.f,
    float ior = 1.5f,
    uniform bool brdf_fresnel = true,
    color diffuse_color = color(1.f, 1.f, 1.f),
    color glossy_color = color(1.f, 1.f, 1.f),
    float glossy_weight = 1.f,
    float roughness = 0.f,
    float3 normal = state::normal())
 =
    let {
        bsdf diffuse = df::diffuse_reflection_bsdf(
            diffuse_color,
            0.f,
            "");
        bsdf glossy = df::simple_glossy_bsdf(
            roughness,
            roughness,
            glossy_color,
            state::texture_tangent_u(0),
            df::scatter_reflect,
            "");
        bsdf layer = brdf_fresnel ? df::fresnel_layer(
            color(ior),
            glossy_weight,
            glossy,
            diffuse,
            state::normal()) : df::custom_curve_layer(
            normal_reflectivity,
            grazing_reflectivity,
            exponent,
            glossy_weight,
            glossy,
            diffuse,
            state::normal());
    } in
        material(
            thin_walled: false,
            surface: material_surface(layer, material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            ior: color(1.f, 1.f, 1.f),
            volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
            geometry: material_geometry(
                float3(0.f),
                1.f,
                normal));

export material FresnelDiffuseGlossy(
    float ior = 1.5f,
    color diffuse_color = color(1.f, 1.f, 1.f),
    color glossy_color = color(1.f, 1.f, 1.f),
    float glossy_weight = 1.f,
    float roughness = 0.f,
    float3 normal = state::normal())
 = material(
    thin_walled: false,
    surface: material_surface(df::fresnel_layer(
        color(ior),
        glossy_weight,
        df::simple_glossy_bsdf(
            roughness,
            roughness,
            glossy_color,
            state::texture_tangent_u(0),
            df::scatter_reflect,
            ""),
        df::diffuse_reflection_bsdf(
            diffuse_color,
            0.f,
            ""),
        state::normal()), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    ior: color(1.f, 1.f, 1.f),
    volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
    geometry: material_geometry(
        float3(0.f),
        1.f,
        normal));

export material SimpleRubber(
    color rubber_color = color(0.f, 0.f, 0.f),
    float rubber_reflectivity = 0.200000003f)
 = material(
    thin_walled: false,
    surface: material_surface(df::custom_curve_layer(
        0.25f,
        0.5f,
        5.f,
        rubber_reflectivity,
        df::simple_glossy_bsdf(
            0.25f,
            0.25f,
            color(1.f, 1.f, 1.f),
            state::texture_tangent_u(0),
            df::scatter_reflect,
            ""),
        df::diffuse_reflection_bsdf(
            rubber_color,
            1.f,
            ""),
        state::normal()), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    ior: color(1.f, 1.f, 1.f),
    volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
    geometry: material_geometry(
        float3(0.f),
        1.f,
        state::normal()));

export material SimpleTranslucent(
    uniform bool thin_walled = false,
    color transmission_color = color(0.8999999762f, 0.8999999762f, 0.8999999762f),
    color reflection_color = color(0.8999999762f, 0.8999999762f, 0.8999999762f),
    float transmission_weight = 0.5f)
 =
    let {
        bsdf diffuse_transmission_bsdf = df::diffuse_transmission_bsdf(transmission_color, "");
        bsdf diffuse_reflection_bsdf = df::diffuse_reflection_bsdf(
            reflection_color,
            0.f,
            "");
    } in
        material(
            thin_walled: thin_walled,
            surface: material_surface(df::normalized_mix(df::bsdf_component[](df::bsdf_component(transmission_weight, diffuse_transmission_bsdf), df::bsdf_component(1.f - transmission_weight, diffuse_reflection_bsdf))), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            ior: color(1.f, 1.f, 1.f),
            volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
            geometry: material_geometry(
                float3(0.f),
                1.f,
                state::normal()));

export material SimpleDispersiveGlossy(
    uniform float ior = 1.5f,
    uniform float abbe_number = 40.f,
    color reflection_color = color(1.f, 1.f, 1.f),
    float reflection_weight = 1.f,
    float reflection_roughness = 0.f,
    color transmission_color = color(1.f, 1.f, 1.f),
    float transmission_roughness = 0.f)
 = material(
    thin_walled: false,
    surface: material_surface(df::fresnel_layer(
        color(ior),
        reflection_weight,
        df::simple_glossy_bsdf(
            reflection_roughness,
            reflection_roughness,
            reflection_color,
            state::texture_tangent_u(0),
            df::scatter_reflect,
            ""),
        df::simple_glossy_bsdf(
            transmission_roughness,
            transmission_roughness,
            transmission_color,
            state::texture_tangent_u(0),
            df::scatter_transmit,
            ""),
        state::normal()), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    ior: base::abbe_number_ior(ior, abbe_number),
    volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
    geometry: material_geometry(
        float3(0.f),
        1.f,
        state::normal()));

export material SimpleMirror()
 = material(
    thin_walled: false,
    surface: material_surface(df::custom_curve_layer(
        1.f,
        1.f,
        5.f,
        1.f,
        df::specular_bsdf(
            color(1.f, 1.f, 1.f),
            df::scatter_reflect,
            ""),
        bsdf(),
        state::normal()), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    ior: color(1.f, 1.f, 1.f),
    volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
    geometry: material_geometry(
        float3(0.f),
        1.f,
        state::normal()));

export material SimpleTransparent(
    color tint = color(0.8000000119f, 0.8000000119f, 0.8000000119f),
    float transparency_weight = 0.8000000119f)
 =
    let {
        bsdf specular_bsdf = df::specular_bsdf(
            tint,
            df::scatter_reflect_transmit,
            "");
        bsdf diffuse_reflection_bsdf = df::diffuse_reflection_bsdf(
            tint,
            0.f,
            "");
    } in
        material(
            thin_walled: true,
            surface: material_surface(df::normalized_mix(df::bsdf_component[](df::bsdf_component(transparency_weight, specular_bsdf), df::bsdf_component(1.f - transparency_weight, diffuse_reflection_bsdf))), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            ior: color(1.f, 1.f, 1.f),
            volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
            geometry: material_geometry(
                float3(0.f),
                1.f,
                state::normal()));

export material SimpleGlass(
    color tint = color(0.8000000119f, 0.8000000119f, 0.8000000119f),
    float distance_scale = 1.f,
    uniform float ior = 1.5f,
    uniform bool thin_walled = false,
    float roughness = 0.f)
 = material(
    thin_walled: thin_walled,
    surface: material_surface(df::simple_glossy_bsdf(
        roughness,
        roughness,
        color(1.f, 1.f, 1.f),
        state::texture_tangent_u(0),
        df::scatter_reflect_transmit,
        ""), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    ior: color(ior),
    volume: material_volume(
        vdf(),
        distance_scale <= 0.f ? color(0.f, 0.f, 0.f) : math::log(tint) / -distance_scale,
        color(0.f, 0.f, 0.f)),
    geometry: material_geometry(
        float3(0.f),
        1.f,
        state::normal()));

export material SimpleChrome()
 = material(
    thin_walled: false,
    surface: material_surface(df::custom_curve_layer(
        0.8199999928f,
        1.f,
        5.f,
        1.f,
        df::simple_glossy_bsdf(
            0.009999999776f,
            0.009999999776f,
            color(0.9599999785f, 0.9599999785f, 0.9599999785f),
            state::texture_tangent_u(0),
            df::scatter_reflect,
            ""),
        df::diffuse_reflection_bsdf(
            color(0.150000006f, 0.150000006f, 0.150000006f),
            0.5f,
            ""),
        state::normal()), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    ior: color(1.f, 1.f, 1.f),
    volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
    geometry: material_geometry(
        float3(0.f),
        1.f,
        state::normal()));

export material SimpleChecker(
    color checker_color1 = color(1.f, 1.f, 1.f),
    color checker_color2 = color(0.f, 0.f, 0.f),
    uniform float checker_ratio = 0.5f,
    uniform float3 checker_rotation = float3(0.f),
    uniform float3 checker_translation = float3(0.f),
    uniform float3 checker_scaling = float3(1.f),
    uniform float checker_blur = 0.f,
    float ior = 1.5f,
    color glossy_color = color(1.f, 1.f, 1.f),
    float glossy_weight = 1.f,
    float roughness = 0.f)
 =
    let {
        uniform float4x4 t = base::rotation_translation_scale(
            checker_rotation,
            checker_translation,
            checker_scaling);
        color checker_return = base::checker_texture(
            base::transform_coordinate(t, base::texture_coordinate_info(
                state::texture_coordinate(0),
                state::texture_tangent_u(0),
                state::texture_tangent_v(0),
                0)),
            checker_color1,
            checker_color2,
            checker_blur,
            checker_ratio).tint;
    } in
        ::FresnelDiffuseGlossy(
            ior: ior,
            diffuse_color: checker_return,
            glossy_color: glossy_color,
            glossy_weight: glossy_weight,
            roughness: roughness,
            normal: state::normal());

export material GenericTextured(
    uniform texture_2d tex_diffuse = texture_2d(),
    uniform texture_2d tex_bump = texture_2d(),
    uniform texture_2d tex_spec = texture_2d(),
    bool use_diffuse_tex = true,
    bool use_bump_tex = false,
    bool use_spec_tex = false,
    uniform float bump_amount = 1.f,
    uniform float3 tex_rotation = float3(0.f),
    uniform float3 tex_translation = float3(0.f),
    uniform float3 tex_scaling = float3(1.f),
    uniform bool clip = false,
    uniform int texture_space = 0,
    uniform bool brdf_fresnel = true,
    float normal_reflectivity = 0.200000003f,
    float grazing_reflectivity = 1.f,
    float exponent = 5.f,
    float ior = 1.5f,
    color diffuse_color = color(0.7799999714f, 0.7900000215f, 0.7599999905f),
    color glossy_color = color(1.f, 1.f, 1.f),
    float glossy_weight = 1.f,
    float roughness = 0.f)
 =
    let {
        tex::wrap_mode wrap_mode = clip ? tex::wrap_clamp : tex::wrap_repeat;
        uniform float4x4 t = base::rotation_translation_scale(
            tex_rotation,
            tex_translation,
            tex_scaling);
        color diffuse_return = use_diffuse_tex ? base::file_texture(
            tex_diffuse,
            color(0.f, 0.f, 0.f),
            color(1.f, 1.f, 1.f),
            base::mono_alpha,
            base::transform_coordinate(t, base::coordinate_source(base::texture_coordinate_uvw, texture_space)),
            float2(0.f, 1.f),
            float2(0.f, 1.f),
            wrap_mode,
            wrap_mode,
            clip,
            0.f,
            int2(0),
            tex::wrap_repeat,
            30.f).tint : diffuse_color;
        float glossy_return = use_spec_tex ? base::file_texture(
            tex_spec,
            color(0.f, 0.f, 0.f),
            color(1.f, 1.f, 1.f),
            base::mono_alpha,
            base::transform_coordinate(t, base::coordinate_source(base::texture_coordinate_uvw, texture_space)),
            float2(0.f, 1.f),
            float2(0.f, 1.f),
            wrap_mode,
            wrap_mode,
            clip,
            0.f,
            int2(0),
            tex::wrap_repeat,
            30.f).mono : glossy_weight;
        float3 normal = use_bump_tex ? base::file_bump_texture(
            tex_bump,
            bump_amount,
            base::mono_average,
            base::transform_coordinate(t, base::coordinate_source(base::texture_coordinate_uvw, texture_space)),
            float2(0.f, 1.f),
            float2(0.f, 1.f),
            wrap_mode,
            wrap_mode,
            state::normal(),
            clip,
            false,
            0.f,
            int2(0),
            tex::wrap_repeat,
            30.f) : state::normal();
    } in
        ::LayeredDiffuseGlossy(
            normal_reflectivity: normal_reflectivity,
            grazing_reflectivity: grazing_reflectivity,
            exponent: exponent,
            ior: ior,
            brdf_fresnel: brdf_fresnel,
            diffuse_color: diffuse_return,
            glossy_color: glossy_color,
            glossy_weight: glossy_return,
            roughness: roughness,
            normal: normal);

export material SimpleFresnelCoat(
    material base_material = material(
        thin_walled: false,
        surface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
        backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
        ior: color(1.f, 1.f, 1.f),
        volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
        geometry: material_geometry(
            float3(0.f),
            1.f,
            state::normal())),
    uniform color ior = color(1.5f, 1.5f, 1.5f),
    color reflection_color = color(0.6999999881f, 0.6999999881f, 0.6999999881f))
 = material(
    thin_walled: base_material.thin_walled,
    surface: material_surface(df::fresnel_layer(
        ior,
        1.f,
        df::specular_bsdf(
            reflection_color,
            df::scatter_reflect,
            ""),
        base_material.surface.scattering,
        state::normal()), base_material.surface.emission),
    backface: base_material.backface,
    ior: base_material.ior,
    volume: base_material.volume,
    geometry: material_geometry(
        base_material.geometry.displacement,
        base_material.geometry.cutout_opacity,
        base_material.geometry.normal));

export material SimpleThinWalled(material base_material = material(
    thin_walled: false,
    surface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    ior: color(1.f, 1.f, 1.f),
    volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
    geometry: material_geometry(
        float3(0.f),
        1.f,
        state::normal())))
 = material(
    thin_walled: true,
    surface: base_material.surface,
    backface: base_material.backface,
    ior: base_material.ior,
    volume: base_material.volume,
    geometry: material_geometry(
        base_material.geometry.displacement,
        base_material.geometry.cutout_opacity,
        base_material.geometry.normal));

export material SimpleCutout(
    material base_material = material(
        thin_walled: false,
        surface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
        backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
        ior: color(1.f, 1.f, 1.f),
        volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
        geometry: material_geometry(
            float3(0.f),
            1.f,
            state::normal())),
    uniform texture_2d cutout_map = texture_2d(),
    base::texture_coordinate_info uvw = base::texture_coordinate_info(
        state::texture_coordinate(0),
        state::texture_tangent_u(0),
        state::texture_tangent_v(0),
        0),
    uniform bool clip = false,
    uniform base::mono_mode mono_source = base::mono_luminance)
 =
    let {
        tex::wrap_mode wrap_mode = clip ? tex::wrap_clamp : tex::wrap_repeat;
        float cutout = base::file_texture(
            cutout_map,
            color(0.f, 0.f, 0.f),
            color(1.f, 1.f, 1.f),
            mono_source,
            uvw,
            float2(0.f, 1.f),
            float2(0.f, 1.f),
            wrap_mode,
            wrap_mode,
            clip,
            0.f,
            int2(0),
            tex::wrap_repeat,
            30.f).mono;
    } in
        material(
            thin_walled: true,
            surface: base_material.surface,
            backface: base_material.backface,
            ior: base_material.ior,
            volume: base_material.volume,
            geometry: material_geometry(
                base_material.geometry.displacement,
                cutout,
                base_material.geometry.normal));

export material SimpleMeasuredMaterial(uniform bsdf_measurement bsdf_data = bsdf_measurement("./green.mbsdf"))
 = material(
    thin_walled: false,
    surface: material_surface(df::measured_bsdf(
        bsdf_data,
        1.f,
        df::scatter_reflect,
        ""), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    ior: color(1.f, 1.f, 1.f),
    volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
    geometry: material_geometry(
        float3(0.f),
        1.f,
        state::normal()));

export material SimplePaper(
    color paper_front_color = color(0.8000000119f, 0.8000000119f, 0.8000000119f),
    color paper_back_color = color(0.8000000119f, 0.8000000119f, 0.8000000119f),
    float transluscency = 0.5f)
 =
    let {
        df::bsdf_component diffuse_bsdf1(1.f - transluscency, df::diffuse_reflection_bsdf(
            paper_front_color,
            0.f,
            ""));
        df::bsdf_component transmissive_bsdf1(transluscency, df::diffuse_transmission_bsdf(paper_front_color, ""));
        df::bsdf_component diffuse_bsdf2(1.f - transluscency, df::diffuse_reflection_bsdf(
            paper_back_color,
            0.f,
            ""));
        bsdf diffuse_layers1 = df::normalized_mix(df::bsdf_component[](diffuse_bsdf1, transmissive_bsdf1));
        bsdf diffuse_layers2 = df::normalized_mix(df::bsdf_component[](diffuse_bsdf2, transmissive_bsdf1));
    } in
        material(
            thin_walled: false,
            surface: material_surface(diffuse_layers1, material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            backface: material_surface(diffuse_layers2, material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            ior: color(1.f, 1.f, 1.f),
            volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
            geometry: material_geometry(
                float3(0.f),
                1.f,
                state::normal()));

export material SimpleCarpaint(
    color clearcoat_color = color(0.6999999881f, 0.6999999881f, 0.6999999881f),
    float clearcoat_ior = 1.5f,
    color flake_color = color(0.6999999881f, 0.6999999881f, 0.6999999881f),
    uniform float flake_strength = 0.200000003f,
    uniform float flake_scale = 1.f,
    uniform float flake_density = 0.5f,
    uniform float flake_reflectivity = 0.5f,
    color glossy_base_color = color(0.6999999881f, 0.6999999881f, 0.6999999881f),
    color diffuse_base_color = color(0.6999999881f, 0.f, 0.f),
    float glossy_base_roughness = 0.1000000015f,
    uniform texture_2d base_bump_map = texture_2d(),
    uniform bool use_base_bump = false,
    uniform float base_bump_amount = 1.f)
 =
    let {
        df::bsdf_component base_diffuse(0.5f, df::diffuse_reflection_bsdf(
            diffuse_base_color,
            0.f,
            ""));
        df::bsdf_component base_glossy(0.5f, df::simple_glossy_bsdf(
            glossy_base_roughness,
            glossy_base_roughness,
            glossy_base_color,
            state::texture_tangent_u(0),
            df::scatter_reflect,
            ""));
        float3 base_bump = use_base_bump ? base::file_bump_texture(
            base_bump_map,
            base_bump_amount,
            base::mono_average,
            base::texture_coordinate_info(
                state::texture_coordinate(0),
                state::texture_tangent_u(0),
                state::texture_tangent_v(0),
                0),
            float2(0.f, 1.f),
            float2(0.f, 1.f),
            tex::wrap_repeat,
            tex::wrap_repeat,
            state::normal(),
            false,
            false,
            0.f,
            int2(0),
            tex::wrap_repeat,
            30.f) : state::normal();
        bsdf base = df::normalized_mix(df::bsdf_component[](base_diffuse, base_glossy));
        bsdf flake = df::simple_glossy_bsdf(
            0.1000000015f,
            0.1000000015f,
            flake_color,
            state::texture_tangent_u(0),
            df::scatter_reflect,
            "");
        float3 flake_bump = base::flake_noise_bump_texture(
            base::texture_coordinate_info(
                state::texture_coordinate(0),
                state::texture_tangent_u(0),
                state::texture_tangent_v(0),
                0),
            flake_scale,
            flake_strength,
            0,
            1.f,
            0,
            state::normal());
        float flake_weight = base::flake_noise_texture(
            base::texture_coordinate_info(
                state::texture_coordinate(0),
                state::texture_tangent_u(0),
                state::texture_tangent_v(0),
                0),
            flake_reflectivity,
            flake_scale,
            flake_density,
            0,
            1.f,
            0).mono;
    } in
        material(
            thin_walled: false,
            surface: material_surface(df::fresnel_layer(
                color(clearcoat_ior),
                1.f,
                df::specular_bsdf(
                    clearcoat_color,
                    df::scatter_reflect,
                    ""),
                df::weighted_layer(
                    flake_weight,
                    flake,
                    base,
                    flake_bump),
                state::normal()), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            ior: color(1.f, 1.f, 1.f),
            volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
            geometry: material_geometry(
                float3(0.f),
                1.f,
                base_bump));

export material SimpleScatter(
    uniform color tint = color(0.1000000015f, 0.9200000167f, 0.200000003f),
    uniform float distance_scale = 0.009999999776f,
    uniform float ior = 1.200000048f,
    float directional_bias = 0.f)
 = material(
    thin_walled: false,
    surface: material_surface(df::specular_bsdf(
        color(1.f, 1.f, 1.f),
        df::scatter_reflect_transmit,
        ""), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
    ior: color(ior),
    volume: material_volume(
        df::anisotropic_vdf(directional_bias, ""),
        distance_scale <= 0.f ? color(0.f, 0.f, 0.f) : math::log(tint) / -distance_scale,
        distance_scale <= 0.f ? color(0.f, 0.f, 0.f) : color(-0.6931471825f, -0.6931471825f, -0.6931471825f) / -distance_scale),
    geometry: material_geometry(
        float3(0.f),
        1.f,
        state::normal()));

export material SimpleDirt(
    material base_material = material(
        thin_walled: false,
        surface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
        backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
        ior: color(1.f, 1.f, 1.f),
        volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
        geometry: material_geometry(
            float3(0.f),
            1.f,
            state::normal())),
    uniform texture_2d dirt_color_texture = texture_2d(),
    uniform texture_2d dirt_mask_texture = texture_2d(),
    uniform texture_2d dirt_bump_texture = texture_2d(),
    uniform bool dirt_use_color_textue = false,
    uniform bool dirt_use_bump_textue = false,
    color dirt_color = color(0.8000000119f, 0.400000006f, 0.1000000015f))
 =
    let {
        color diffuse_result = dirt_use_color_textue ? base::file_texture(
            dirt_color_texture,
            color(0.f, 0.f, 0.f),
            color(1.f, 1.f, 1.f),
            base::mono_alpha,
            base::texture_coordinate_info(
                state::texture_coordinate(0),
                state::texture_tangent_u(0),
                state::texture_tangent_v(0),
                0),
            float2(0.f, 1.f),
            float2(0.f, 1.f),
            tex::wrap_repeat,
            tex::wrap_repeat,
            false,
            0.f,
            int2(0),
            tex::wrap_repeat,
            30.f).tint : dirt_color;
        float mask_result = base::file_texture(
            dirt_mask_texture,
            color(0.f, 0.f, 0.f),
            color(1.f, 1.f, 1.f),
            base::mono_luminance,
            base::texture_coordinate_info(
                state::texture_coordinate(0),
                state::texture_tangent_u(0),
                state::texture_tangent_v(0),
                0),
            float2(0.f, 1.f),
            float2(0.f, 1.f),
            tex::wrap_repeat,
            tex::wrap_repeat,
            false,
            0.f,
            int2(0),
            tex::wrap_repeat,
            30.f).mono;
        float3 normal = dirt_use_bump_textue ? base::file_bump_texture(
            dirt_bump_texture,
            1.f,
            base::mono_average,
            base::texture_coordinate_info(
                state::texture_coordinate(0),
                state::texture_tangent_u(0),
                state::texture_tangent_v(0),
                0),
            float2(0.f, 1.f),
            float2(0.f, 1.f),
            tex::wrap_repeat,
            tex::wrap_repeat,
            state::normal(),
            false,
            false,
            0.f,
            int2(0),
            tex::wrap_repeat,
            30.f) : state::normal();
    } in
        material(
            thin_walled: base_material.thin_walled,
            surface: material_surface(df::weighted_layer(
                mask_result,
                df::diffuse_reflection_bsdf(
                    diffuse_result,
                    0.f,
                    ""),
                base_material.surface.scattering,
                normal), material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
            backface: base_material.backface,
            ior: base_material.ior,
            volume: base_material.volume,
            geometry: material_geometry(
                base_material.geometry.displacement,
                base_material.geometry.cutout_opacity,
                base_material.geometry.normal));

export material SimpleDisplacement(
    material base_material = material(
        thin_walled: false,
        surface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
        backface: material_surface(scattering: bsdf(), emission: material_emission(emission: edf(), intensity: color(0.f, 0.f, 0.f), mode: intensity_radiant_exitance)),
        ior: color(1.f, 1.f, 1.f),
        volume: material_volume(scattering: vdf(), absorption_coefficient: color(0.f, 0.f, 0.f), scattering_coefficient: color(0.f, 0.f, 0.f)),
        geometry: material_geometry(
            float3(0.f),
            1.f,
            state::normal())) [[
        anno::display_name("Base Material"),
        anno::in_group("Base")
    ]],
    uniform texture_2d displacement_texture = texture_2d() [[
        anno::display_name("Displacement Texture"),
        anno::in_group("Displacement")
    ]],
    uniform bool use_displacement_texture = false [[
        anno::display_name("Use Displacement Texture"),
        anno::in_group("Displacement")
    ]],
    float displacement_value = 0.f [[
        anno::display_name("Displacement Value"),
        anno::in_group("Displacement")
    ]])
[[
    anno::display_name("Simple Displacement"),
    anno::description("Simple Displacement material")
]]
 =
    let
        float disp = use_displacement_texture ? base::file_texture(
            displacement_texture,
            color(0.f, 0.f, 0.f),
            color(1.f, 1.f, 1.f),
            base::mono_alpha,
            base::texture_coordinate_info(
                state::texture_coordinate(0),
                state::texture_tangent_u(0),
                state::texture_tangent_v(0),
                0),
            float2(0.f, 1.f),
            float2(0.f, 1.f),
            tex::wrap_repeat,
            tex::wrap_repeat,
            false,
            0.f,
            int2(0),
            tex::wrap_repeat,
            30.f).mono : displacement_value;
    in
        material(
            thin_walled: base_material.thin_walled,
            surface: base_material.surface,
            backface: base_material.backface,
            ior: base_material.ior,
            volume: base_material.volume,
            geometry: material_geometry(
                state::normal() * disp,
                base_material.geometry.cutout_opacity,
                base_material.geometry.normal));

export material TexturedRounded(
    uniform float round_corner_radius = 0.f,
    uniform bool across_materials = false,
    uniform float roundness = 1.f,
    uniform texture_2d tex_diffuse = texture_2d(),
    uniform texture_2d tex_spec = texture_2d(),
    bool use_diffuse_tex = true,
    bool use_spec_tex = false,
    uniform float3 tex_rotation = float3(0.f),
    uniform float3 tex_translation = float3(0.f),
    uniform float3 tex_scaling = float3(1.f),
    uniform bool clip = false,
    uniform int texture_space = 0,
    uniform bool brdf_fresnel = true,
    float normal_reflectivity = 0.200000003f,
    float grazing_reflectivity = 1.f,
    float exponent = 5.f,
    float ior = 1.5f,
    color diffuse_color = color(0.7799999714f, 0.7900000215f, 0.7599999905f),
    color glossy_color = color(1.f, 1.f, 1.f),
    float glossy_weight = 1.f,
    float roughness = 0.f)
 =
    let {
        tex::wrap_mode wrap_mode = clip ? tex::wrap_clamp : tex::wrap_repeat;
        uniform float4x4 t = base::rotation_translation_scale(
            tex_rotation,
            tex_translation,
            tex_scaling);
        color diffuse_return = use_diffuse_tex ? base::file_texture(
            tex_diffuse,
            color(0.f, 0.f, 0.f),
            color(1.f, 1.f, 1.f),
            base::mono_alpha,
            base::transform_coordinate(t, base::coordinate_source(base::texture_coordinate_uvw, texture_space)),
            float2(0.f, 1.f),
            float2(0.f, 1.f),
            wrap_mode,
            wrap_mode,
            clip,
            0.f,
            int2(0),
            tex::wrap_repeat,
            30.f).tint : diffuse_color;
        float glossy_return = use_spec_tex ? base::file_texture(
            tex_spec,
            color(0.f, 0.f, 0.f),
            color(1.f, 1.f, 1.f),
            base::mono_alpha,
            base::transform_coordinate(t, base::coordinate_source(base::texture_coordinate_uvw, texture_space)),
            float2(0.f, 1.f),
            float2(0.f, 1.f),
            wrap_mode,
            wrap_mode,
            clip,
            0.f,
            int2(0),
            tex::wrap_repeat,
            30.f).mono : glossy_weight;
        float3 normal = state::rounded_corner_normal(
            round_corner_radius,
            across_materials,
            roundness);
    } in
        ::LayeredDiffuseGlossy(
            normal_reflectivity: normal_reflectivity,
            grazing_reflectivity: grazing_reflectivity,
            exponent: exponent,
            ior: ior,
            brdf_fresnel: brdf_fresnel,
            diffuse_color: diffuse_return,
            glossy_color: glossy_color,
            glossy_weight: glossy_return,
            roughness: roughness,
            normal: normal);
