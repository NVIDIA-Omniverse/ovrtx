(
    subLayers = [@./ovrtx-test-decals.usda@]
)

# [snippet:doc-decal-ordering-usda]
over "World"
{
    over "RedRTXA"
    {
        # Silver stays at 10. Raising red from 0 to 20 puts red on top.
        # RedRTXB and RedRTXC inherit this value from RedRTXA.
        int omni:decal:priority = 20
    }
}
# [/snippet:doc-decal-ordering-usda]
