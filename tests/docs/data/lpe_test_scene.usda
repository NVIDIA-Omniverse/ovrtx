#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Camera "Camera"
    {
        float2 clippingRange = (0.1, 1000)
        float focalLength = 40
        float horizontalAperture = 20.955
        float verticalAperture = 15.2908
        float3 xformOp:rotateYXZ = (89.22138, -180, 178.63612)
        double3 xformOp:translate = (-6.747290447338486, -8.739438096157297, 1.0727920064412346)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateYXZ"]
    }

    def DomeLight "Environment"
    {
        float inputs:intensity = 1000
        asset inputs:texture:file = @./studio.exr@
        token inputs:texture:format = "latlong"
        float3 xformOp:rotateXYZ = (0, 0, 25)
        uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
    }

    def Cube "Ground" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Diffuse>
        double size = 2
        double3 xformOp:scale = (5, 8, 0.05)
        double3 xformOp:translate = (-6, 2, -0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "DiffuseBlock" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Diffuse>
        double size = 2
        double3 xformOp:scale = (1.3, 1.3, 1.3)
        double3 xformOp:translate = (-8.5, 1.5, 1.3)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Backdrop" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/Diffuse>
        double size = 2
        double3 xformOp:scale = (5, 0.05, 3)
        double3 xformOp:translate = (-6, 7, 3)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Scope "Looks"
    {
        def Material "Diffuse"
        {
            token outputs:mdl:surface.connect = </World/Looks/Diffuse/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.55, 0.16, 0.04)
                float inputs:reflection_roughness_constant = 0.7
                token outputs:out (renderType = "material")
            }
        }
    }
}
