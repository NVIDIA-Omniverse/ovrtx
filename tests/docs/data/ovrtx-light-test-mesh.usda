        float3 xformOp:scale = (200, 200, 200)
        double3 xformOp:translate = (0, 138.50391824796083, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        over "Fluorescent_Tube"
        {
            over "Fluorescent_Tube" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Looks/OmniEmissive> (
                    bindMaterialAs = "weakerThanDescendants"
                )
            }
        }
    }

    def Scope "Looks"
    {
        def Material "OmniEmissive"
        {
            token outputs:mdl:displacement.connect = </World/Looks/OmniEmissive/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/OmniEmissive/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/OmniEmissive/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniEmissive.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniEmissive"
                float inputs:emission_intensity = 200
                color3f inputs:emissive_color = (1, 0.99999, 0.99999)
                token outputs:out (
                    renderType = "material"
                )
            }
        }

        def Material "OmniEmissive_01"
        {
            token outputs:mdl:displacement.connect = </World/Looks/OmniEmissive_01/Shader.outputs:out>
            token outputs:mdl:surface.connect = </World/Looks/OmniEmissive_01/Shader.outputs:out>
            token outputs:mdl:volume.connect = </World/Looks/OmniEmissive_01/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniEmissive.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniEmissive"
                float inputs:emission_intensity = 5
                asset inputs:emissive_color_texture = @./chelsea.png@ (
                    colorSpace = "auto"
                )
                token outputs:out (
                    renderType = "material"
                )
            }
        }
    }

